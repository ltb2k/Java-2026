PORT=5000
DATABASE_URL=postgresql://mushroom:password@localhost:5432/mushroom_iot
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# MQTT (optional — leave blank if no MQTT broker)
MQTT_BROKER_URL=

# Admin account creation (used by: npm run create-admin)
ADMIN_EMAIL=admin@mushroom.local
ADMIN_FULL_NAME=System Admin
ADMIN_PASSWORD=
